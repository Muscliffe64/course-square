[Unit]
Description=AI Course Square
After=network.target

[Service]
Type=simple
User=course-square
Group=course-square
WorkingDirectory=/opt/course-square/current
EnvironmentFile=/etc/course-square.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/course-square/current/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8017 --workers 2 --threads 2 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/course-square

[Install]
WantedBy=multi-user.target
