# Copy to /etc/course-square.env on the server (permissions: root:root 0600).
# Generate a unique secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DATABASE_PATH=/var/lib/course-square/db.sqlite3
MEDIA_ROOT=/var/lib/course-square/media
STATIC_ROOT=/var/lib/course-square/staticfiles
