# Copy to /etc/course-square.env on the server (permissions: root:root 0600).
# Generate a unique secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DATABASE_PATH=/var/lib/course-square/db.sqlite3
MEDIA_ROOT=/var/lib/course-square/media
STATIC_ROOT=/var/lib/course-square/staticfiles

# 站外提醒（可选）：有新的待回应内容时推送给老师，每 30 分钟检查一次。
# Server 酱（推到个人微信）：https://sctapi.ftqq.com/<SendKey>.send
# 也支持企业微信 / 飞书 / 钉钉群机器人的 webhook 地址。
TEACHER_NOTIFY_WEBHOOK=
COURSE_SITE_URL=https://123.57.56.38
TEACHER_NOTIFY_QUIET_HOURS=23-8
